# Copy to .env and fill in. Used by `cargo test --test e2e` to load
# Coralogix test team credentials. .env is gitignored.
#
# The e2e suite writes to the team (creates and deletes resources named
# cx-e2e-*). Point it at the dedicated writable test team only.

CX_API_KEY=
CX_REGION=eu2
# Write tests are skipped unless this is set. Never set it for a real team.
CX_E2E_ALLOW_WRITES=1
