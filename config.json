{
  "integrationDetail": {
    "integration": {
      "id": "aws-metrics-collector",
      "name": "AWS Metrics from CloudWatch",
      "description": "AWS Metrics from CloudWatch integration retrieves all your metrics from a specified AWS account every 10 minutes, with the exception of S3 metrics, which are updated daily on CloudWatch. Tags and metric definitions are pulled every 5 minutes. As a prerequisite, ensure that you set up an AWS IAM policy and role using this <a target='_blank' href='https://github.com/coralogix/cloudformation-coralogix-aws/tree/master/coralogix-policies/coralogix-metrics-integration-policy'>CloudFormation template</a>",
      "icon": "/assets/integrations/aws.svg",
      "darkIcon": "/assets/integrations/aws-dark.svg",
      "tags": [
        "AWS",
        "Pull",
        "Metrics"
      ],
      "versions": [
        "0.1.0",
        "0.11.0"
      ],
      "integrationType": {
        "managed": {
          "variant": "DEFAULT"
        }
      },
