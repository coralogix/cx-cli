{
  "name": "cx-cli-pr176-test-e2m",
  "description": "Temporary test E2M for PR176 console-link verification - safe to delete",
  "permutationsLimit": 1000,
  "type": "E2M_TYPE_LOGS2METRICS",
  "logsQuery": {
    "lucene": "cxclipr176testmarkerunlikelytomatchanyreallogs:true",
    "applicationnameFilters": [],
    "subsystemnameFilters": [],
    "severityFilters": []
  },
  "metricLabels": [
    { "targetLabel": "app", "sourceField": "coralogix.metadata.applicationName" }
  ],
  "metricFields": [
    {
      "targetBaseMetricName": "pr176_test_count",
      "sourceField": "text",
      "aggregations": [
        { "enabled": true, "aggType": "AGG_TYPE_COUNT", "targetMetricName": "pr176_test_count_total" }
      ]
    }
  ]
}
